{
  "private": true,
  "scripts": {
    "contracts:openapi": "python scripts/export_openapi.py",
    "contracts:types": "npm run contracts:openapi && openapi-typescript openapi.json -o static/api-types.d.ts",
    "contracts:check-generated": "python scripts/check_openapi.py && openapi-typescript openapi.json --check -o static/api-types.d.ts",
    "check": "npm run contracts:check-generated && python -m unittest discover -s tests -v",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:test": "npm run test --prefix frontend",
    "frontend:lint": "npm run lint --prefix frontend"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1"
  }
}
