        "x-implementation-status": "planned",
        "operationId": "listOrders",
        "responses": {
          "200": {
            "description": "Order history",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/transactions": {
      "get": {
        "x-implementation-status": "planned",
        "operationId": "listTransactions",
        "responses": {
