# Copy to .env.local for local development. The Flask app loads .env.local automatically.
# On a deployment host, configure these as server-side environment variables instead.

TRADEPOINT_LLM_PROVIDER=groq
TRADEPOINT_GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=replace-with-a-server-side-groq-api-key

# Existing application settings (safe local defaults; change SECRET_KEY outside local development).
TRADEPOINT_DATABASE_URL=sqlite:///tradepoint.db
TRADEPOINT_DEMO_USER_ID=demo-user
TRADEPOINT_INITIAL_CASH=1000000.00
TRADEPOINT_SECRET_KEY=replace-with-a-random-local-secret

# Optional explicit provider choices: composite, huggingface, ollama, heuristic, mock.
# Composite may use the following credentials/settings before its explicitly identified heuristic fallback.
HF_TOKEN=replace-with-a-huggingface-token
# HUGGINGFACE_API_KEY=replace-with-a-huggingface-token
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Other existing provider settings (the defaults use deterministic mocks).
TRADEPOINT_MARKET_PROVIDER=mock
KITE_API_KEY=replace-with-a-kite-api-key
KITE_ACCESS_TOKEN=replace-with-a-kite-access-token
TRADEPOINT_NEWS_PROVIDER=mock

# PayPal Sandbox settings (USD international payments settling into INR wallet balance)
PAYPAL_CLIENT_ID=replace-with-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-sandbox-client-secret
PAYPAL_ENVIRONMENT=sandbox
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

